// MANYAK TV v2 - Database Schema
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model User {
  id                String    @id @default(cuid())
  telegramId        String    @unique
  firstName         String
  lastName          String?
  username          String?
  phoneNumber       String?
  isPhoneVerified   Boolean   @default(false)
  
  // Subscription
  isVip             Boolean   @default(false)
  vipExpiresAt      DateTime?
  vipDiscountPercent Int      @default(0)
  
  // Gamification
  bonusBalance      Int       @default(0)
  dailyCheckIn      Json?     // { lastCheckIn: Date, streak: number }
  
  // Security
  deviceToken       String?   @unique
  hwid              Json?     // Hardware binding
  isBanned          Boolean   @default(false)
  banReason         String?
  isDeviceBanned    Boolean   @default(false)
  
  // Timestamps
  createdAt         DateTime  @default(now())
  lastLoginAt       DateTime?
  
  // Relations
  payments          Payment[]
  watchHistory      WatchHistory[]
  favorites         Favorite[]
  purchasedContent  UserContent[]
  comments          Comment[]
  
  @@index([telegramId])
  @@index([phoneNumber])
  @@index([isVip])
  @@index([createdAt])
}

// ============================================================================
// CONTENT MANAGEMENT
// ============================================================================

model Content {
  id              String        @id @default(cuid())
  type            ContentType
  title           String
  description     String?
  posterUrl       String?
  trailerUrl      String?
  
  // Video
  videoUrl        String?
  duration        Int?          // seconds
  quality         String[]      // ["360p", "720p", "1080p"]
  
  // Metadata
  year            Int?
  country         String?
  language        String?
  ageRating       String?       // PG-13, R, etc.
  imdbRating      Float?
  genres          String[]
  cast            String[]
  director        String?
  
  // Pricing
  isPremium       Boolean       @default(false)
  price           Int?
  unlockWithTokens Int?
  
  // Stats
  viewsCount      Int           @default(0)
  likesCount      Int           @default(0)
  revenue         Int           @default(0)
  
  // Status
  isPublished     Boolean       @default(false)
  publishedAt     DateTime?
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Relations
  episodes        Episode[]
  watchHistory    WatchHistory[]
  favorites       Favorite[]
  purchasedBy     UserContent[]
  comments        Comment[]
  categories      ContentCategory[]
  
  @@index([type])
  @@index([isPremium])
  @@index([isPublished])
  @@index([createdAt])
  @@fulltext([title, description])
}

model Episode {
  id              String    @id @default(cuid())
  contentId       String
  content         Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  episodeNumber   Int
  seasonNumber    Int       @default(1)
  title           String
  description     String?
  
  // Video
  videoUrl        String
  thumbnailUrl    String?
  duration        Int       // seconds
  quality         String[]
  
  // Stats
  viewsCount      Int       @default(0)
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([contentId, seasonNumber, episodeNumber])
  @@index([contentId])
}

enum ContentType {
  MOVIE
  SERIES
  SHORT
  LIVE
}

// ============================================================================
// CATEGORIZATION
// ============================================================================

model Category {
  id              String            @id @default(cuid())
  name            String            @unique
  slug            String            @unique
  icon            String?
  order           Int               @default(0)
  
  contents        ContentCategory[]
  
  @@index([slug])
  @@index([order])
}

model ContentCategory {
  contentId       String
  categoryId      String
  
  content         Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@id([contentId, categoryId])
}

// ============================================================================
// PAYMENTS & SUBSCRIPTIONS
// ============================================================================

model Payment {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  type            PaymentType
  status          PaymentStatus @default(PENDING)
  
  // Amount
  amount          Int           // in som/coins
  discountApplied Int           @default(0)
  promoCodeUsed   String?
  
  // Details
  planId          String?
  plan            SubscriptionPlan? @relation(fields: [planId], references: [id])
  contentId       String?
  contentTitle    String?
  
  // Receipt
  receiptImageUrl String?
  notes           String?
  
  // Review
  reviewedAt      DateTime?
  reviewedBy      String?       // Admin ID
  
  // Timestamps
  createdAt       DateTime      @default(now())
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentType {
  VIP_SUBSCRIPTION
  CONTENT_PURCHASE
  TOKEN_PURCHASE
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model SubscriptionPlan {
  id              String    @id @default(cuid())
  name            String
  description     String?
  
  // Pricing
  price           Int
  originalPrice   Int?
  durationDays    Int
  
  // Display
  badge           String?   // "POPULAR", "BEST VALUE"
  isActive        Boolean   @default(true)
  
  // Features
  features        String[]
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  payments        Payment[]
  
  @@index([isActive])
}

model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  
  // Usage limits
  maxUses         Int       @default(100)
  currentUses     Int       @default(0)
  
  // Validity
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  
  // Timestamps
  createdAt       DateTime  @default(now())
  
  @@index([code])
  @@index([isActive])
}

// ============================================================================
// USER INTERACTIONS
// ============================================================================

model WatchHistory {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  contentId       String
  content         Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  episodeId       String?
  
  // Progress
  progressSeconds Int       @default(0)
  totalSeconds    Int       @default(0)
  
  // Timestamps
  watchedAt       DateTime  @default(now())
  
  @@index([userId])
  @@index([contentId])
  @@index([watchedAt])
}

model Favorite {
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  contentId       String
  content         Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  addedAt         DateTime  @default(now())
  
  @@id([userId, contentId])
  @@index([userId])
}

model UserContent {
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  contentId       String
  content         Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  purchasedAt     DateTime  @default(now())
  
  @@id([userId, contentId])
  @@index([userId])
}

model Comment {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  contentId       String
  content         Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  episodeId       String?
  text            String
  
  createdAt       DateTime  @default(now())
  
  @@index([contentId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================================
// ADMIN & AUDIT
// ============================================================================

model Admin {
  id              String    @id @default(cuid())
  telegramId      String    @unique
  name            String
  username        String?
  roleTitle       String    @default("Admin")
  
  isSuperAdmin    Boolean   @default(false)
  permissions     Json      // AdminPermissions object
  
  appointedBy     String?
  appointedAt     DateTime  @default(now())
  
  @@index([telegramId])
  @@index([isSuperAdmin])
}

model AuditLog {
  id              Int       @id @default(autoincrement())
  adminId         String
  adminName       String
  
  action          String    // CREATE_CONTENT, DELETE_USER, etc.
  targetType      String?   // CONTENT, USER, PAYMENT
  targetId        String?
  targetTitle     String?
  
  details         String?
  
  secondaryAuthPassed Boolean @default(false)
  
  createdAt       DateTime  @default(now())
  
  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================================
// TELEGRAM INTEGRATION
// ============================================================================

model VerificationCode {
  code            String    @id
  status          CodeStatus @default(PENDING)
  
  telegramId      String?
  chatId          String?
  phoneNumber     String?
  
  createdAt       DateTime  @default(now())
  verifiedAt      DateTime?
  claimedAt       DateTime?
  
  @@index([status])
  @@index([createdAt])
}

enum CodeStatus {
  PENDING
  VERIFIED
  CLAIMED
  EXPIRED
}

model BannedDevice {
  deviceToken     String    @id
  bannedAt        DateTime  @default(now())
  
  @@index([bannedAt])
}

// ============================================================================
// SYSTEM SETTINGS
// ============================================================================

model SystemSettings {
  id              Int       @id @default(1)
  
  // Bot
  botUsername     String?
  telegramBotUsername String?
  telegramChannelUrl String?
  adminContactUrl String?
  
  // Payment
  paymentMethods  Json?     // Array of payment methods
  
  // Features
  enableComments  Boolean   @default(true)
  enableRatings   Boolean   @default(true)
  maintenanceMode Boolean   @default(false)
  
  // Pricing
  tokenPrice      Int       @default(1000)
  
  updatedAt       DateTime  @updatedAt
  
  @@map("system_settings")
}
