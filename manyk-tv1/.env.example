# MANYK TV Backend Environment Variables — TEMPLATE
# ========================================
# MUHIM: Bu faylni .env deb nomla va haqiqiy qiymatlar bilan to'ldir!
# HECH QACHON haqiqiy tokenlar/secretlar bilan commit qilma!

# ══════════════════════════════════════════════════════════════════
#  TELEGRAM BOT SOZLAMALARI
# ══════════════════════════════════════════════════════════════════

# Telegram Bot Token (@BotFather dan olinadi)
# Misol: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"

# Super Admin Telegram ID (o'zingizning haqiqiy Telegram ID'ingiz)
# ID ni olish: @userinfobot ga /start yubor
SUPER_ADMIN_ID="YOUR_TELEGRAM_ID"

# Qo'shimcha admin IDlar (vergul bilan ajrating)
# Misol: "123456789,987654321"
ADMIN_IDS=""

# ══════════════════════════════════════════════════════════════════
#  XAVFSIZLIK SOZLAMALARI (JUDA MUHIM!)
# ══════════════════════════════════════════════════════════════════

# Webhook secret (Telegram webhook xavfsizligi uchun)
# KUCHLI, tasodifiy qiymat yarating! Kamida 32 belgi.
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET="GENERATE_RANDOM_64_CHAR_HEX_STRING"

# JWT maxfiy kaliti (JSON Web Token imzosi uchun)
# KUCHLI, tasodifiy qiymat yarating! Kamida 32 belgi.
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="GENERATE_RANDOM_64_CHAR_HEX_STRING"

# ══════════════════════════════════════════════════════════════════
#  ILOVANI SOZLAMALARI
# ══════════════════════════════════════════════════════════════════

# APP_URL — Frontend URL (HTTPS bilan!)
# Lokal development: http://localhost:5173
# Production: https://yourapp.com
APP_URL="http://localhost:5173"

# NODE_ENV — Muhit (development/production)
NODE_ENV="development"

# Server port
PORT=3001

# ══════════════════════════════════════════════════════════════════
#  DATABASE SOZLAMALARI (PostgreSQL)
# ══════════════════════════════════════════════════════════════════

# PostgreSQL Host
PG_HOST="localhost"

# PostgreSQL Port
PG_PORT="5432"

# PostgreSQL Database nomi
PG_DATABASE="manyaktv"

# PostgreSQL foydalanuvchi
PG_USER="postgres"

# PostgreSQL parol (XAVFSIZ QILING!)
# Production: Railway/Render dashboard'dan kiriting
PG_PASSWORD="abdurahim521"

# PostgreSQL SSL (production uchun)
# Development: false
# Production: true (Railway/Render avtomatik)
PG_SSL="false"

# ══════════════════════════════════════════════════════════════════
#  FAYL JOYLASHUVI
# ══════════════════════════════════════════════════════════════════

# Backup papkasi
BACKUP_DIR="./backups"

# Yuklangan fayllar papkasi
# Lokal: ./uploads
# Production (Railway/Render): /data/uploads (volume)
UPLOADS_DIR="./uploads"

# ══════════════════════════════════════════════════════════════════
#  IXTIYORIY SOZLAMALAR
# ══════════════════════════════════════════════════════════════════

# Google Gemini API kaliti (ixtiyoriy)
GEMINI_API_KEY=""

# ══════════════════════════════════════════════════════════════════
#  XAVFSIZLIK ESLATMALARI
# ══════════════════════════════════════════════════════════════════
#
# 1. HECH QACHON haqiqiy .env faylini git'ga commit qilmang!
# 2. Production secrets albatta o'zgartiring (default'lar ishlatmang)
# 3. JWT_SECRET va WEBHOOK_SECRET kuchli bo'lishi kerak (64+ char)
# 4. Secrets'larni faqat server environment variables'da saqlang
# 5. Railway/Render: Secrets'larni dashboard'dan kiriting
#
# ══════════════════════════════════════════════════════════════════
