# MANYK TV Backend Environment Variables
# ========================================
# DIQQAT: bu loyihaning avvalgi versiyasida haqiqiy bot tokeni, JWT maxfiy
# kaliti va admin-bypass tokeni to'g'ridan-to'g'ri kodga yozilgan edi va
# frontend build ichida oshkor bo'lgan. Agar shu loyihani ilgari joylashtirgan
# bo'lsangiz, quyidagilarning HAMMASINI HOZIROQ ALMASHTIRING:
#   - TELEGRAM_BOT_TOKEN ni @BotFather orqali /revoke qilib, yangisini oling
#   - JWT_SECRET va WEBHOOK_SECRET ni yangi tasodifiy qiymatga o'zgartiring
#     (masalan: `openssl rand -hex 32`)

# Telegram Bot Token (@BotFather dan olinadi)
# MUHIM: Bu tokenni hech qachon frontend kodga yozmang!
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"

# Super Admin Telegram ID (o'zingizning haqiqiy Telegram ID'ingizga o'zgartiring)
SUPER_ADMIN_ID="YOUR_TELEGRAM_ID_HERE"

# Qo'shimcha admin IDlar (vergul bilan ajrating)
ADMIN_IDS=""

# Webhook secret (Telegram webhook xavfsizligi uchun) — tasodifiy qator qiling
WEBHOOK_SECRET="CHANGE_THIS_TO_A_RANDOM_SECRET"

# JWT maxfiy kaliti (tasodifiy murakkab qator, masalan: openssl rand -hex 32)
JWT_SECRET="CHANGE_THIS_TO_A_RANDOM_SECRET"

# Ilova URL (production uchun, https:// bilan)
APP_URL="https://your-domain.com"

# ═══════════════════════════════════════════════════════════════════════
# NODE_ENV — PRODUCTIONDA ALBATTA "production" QILING
# ═══════════════════════════════════════════════════════════════════════
# server.js dagi majburiy maxfiy kalit tekshiruvi FAQAT NODE_ENV=production
# bo'lganda ishlaydi:
#     if (IS_PROD && (!process.env.JWT_SECRET || !process.env.WEBHOOK_SECRET))
#       process.exit(1);
#
# `npm start` esa NODE_ENV ni O'ZI QO'YMAYDI. Ya'ni bu o'zgaruvchisiz server
# .env dagi kalitlar bo'lmasa ham ishga tushadi va kod ichidagi standart
# (git'ga yuklangan, ya'ni OSHKOR) qiymatlarni ishlatadi. Bunday holatda
# istalgan odam o'ziga isAdmin:true JWT yasab, to'liq admin bo'la oladi.
NODE_ENV="production"

# GEMINI_API_KEY: AI Studio uchun (backend ishlatmaydi, faqat frontend AI
# funksiyalari uchun kerak bo'lsa)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server port
PORT=3001

# ═══════════════════════════════════════════════════════════════════════
# MUHIM: ADMINLIK ENDI SERVER TOMONIDAN TASDIQLANADI
# ═══════════════════════════════════════════════════════════════════════
# Avval adminlik brauzer localStorage'idagi sozlamalardan aniqlanardi —
# ya'ni foydalanuvchi o'zini admin qilib ko'rsatishi mumkin edi.
# Endi admin paneli faqat server bergan JWT da `isAdmin: true` bo'lganda
# ochiladi, server esa buni Telegram initData HMAC tekshiruvidan
# (TELEGRAM_BOT_TOKEN yordamida) keyin SUPER_ADMIN_ID / appointed_admins
# jadvali bo'yicha aniqlaydi.
#
# Shundan kelib chiqib:
#   1. TELEGRAM_BOT_TOKEN va SUPER_ADMIN_ID TO'G'RI to'ldirilishi SHART —
#      aks holda HECH KIM (siz ham) admin panelini ocha olmaydi.
#   2. Ilova Telegram bot orqali ochilishi kerak (initData faqat shunda
#      keladi). Oddiy brauzerda ochilganda admin paneli ko'rinmaydi —
#      bu ATAYLAB shunday.
#
# Shuningdek: xavfli amallar uchun ikkinchi darajali PIN kodning qattiq
# yozilgan standart qiymati ('8918') OLIB TASHLANDI. Admin panelidagi
# Sozlamalar bo'limida o'zingizning PIN kodingizni o'rnatishingiz kerak,
# aks holda kontent o'chirish kabi amallar tasdiqlanmaydi.
