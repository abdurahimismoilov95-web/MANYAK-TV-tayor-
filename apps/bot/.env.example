# Bot Service Port
BOT_PORT=3001

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Web App URL (your frontend URL)
WEB_APP_URL=https://your-app.com

# Webhook URL (for production, optional for dev)
WEBHOOK_URL=https://your-bot-api.com/webhook/telegram

# Database URL (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/manyak_tv

# API Service URL (for communication with main API)
API_SERVICE_URL=http://localhost:3000
