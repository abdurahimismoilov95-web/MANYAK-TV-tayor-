# MANYAK TV API - Environment Variables

# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/manyak_tv"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_BOT_SECRET=your-webhook-secret

# Super Admin
SUPER_ADMIN_ID=891846690

# CORS
CORS_ORIGIN=http://localhost:5173

# Redis (Optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload
MAX_FILE_SIZE=2GB
UPLOAD_DIR=./uploads

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
